<UserControl x:Class="PedToolbox.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Style="{StaticResource Subtitle}"
               Text="v1 Steps 4 and 6. Startup edits HKCU/HKLM Run keys. Temp cleanup only touches the current user TEMP folder. Disk Cleanup launches Microsoft's cleanmgr."/>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Startup (Run keys)"/>
        <DataGrid x:Name="StartupGrid" Height="220" Margin="0,8"/>
        <WrapPanel>
          <Button Style="{StaticResource GhostButton}" Content="Refresh" Click="Refresh_OnClick"/>
          <Button Style="{StaticResource DangerButton}" Content="Remove selected startup item" Click="RemoveStartup_OnClick"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Junk"/>
        <WrapPanel Margin="0,10,0,0">
          <Button Style="{StaticResource PrimaryButton}" Content="Clean user TEMP" Click="Temp_OnClick"/>
          <Button Style="{StaticResource GhostButton}" Content="Empty Recycle Bin" Click="Bin_OnClick"/>
          <Button Style="{StaticResource GhostButton}" Content="Disk Cleanup" Click="Disk_OnClick"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
