<UserControl x:Class="PedToolbox.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock FontSize="22" FontWeight="SemiBold" x:Name="TitleText"/>
        <TextBlock Style="{StaticResource Muted}" x:Name="MetaText" Margin="0,8,0,0"/>
        <WrapPanel Margin="0,16,0,0">
          <Button Style="{StaticResource PrimaryButton}" Content="Website" Click="Web_OnClick"/>
          <Button Style="{StaticResource GhostButton}" Content="GitHub" Click="Git_OnClick"/>
          <Button Style="{StaticResource GhostButton}" Content="Email" Click="Mail_OnClick"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Distribution"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                   Text="Winget: YAML under packaging/winget. Publish a signed MSIX or zip, then submit a PR to microsoft/winget-pkgs."/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                   Text="Microsoft Store: package MSIX from packaging/msix, enroll in Partner Center, and keep StoreSafe features only. Service profile Apply is the main Store risk."/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
      <TextBlock TextWrapping="Wrap"
                 Text="This software is provided as-is. Create a restore point first. You are responsible for changes on your PC. v1 batch scripts were not modified; v3 is a separate product in this folder."/>
    </Border>
  </StackPanel>
</UserControl>
